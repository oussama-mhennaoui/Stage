{% extends 'emails/base.html.twig' %}

{% block body %}
    <div class="bg-white p-6 rounded-lg shadow">
        <h1 class="text-2xl font-bold text-gray-800 mb-4">Réinitialisation de votre mot de passe</h1>
        
        <p class="text-gray-700 mb-4">
            Vous avez demandé la réinitialisation de votre mot de passe. Veuillez cliquer sur le bouton ci-dessous pour le réinitialiser :
        </p>
        
        <div class="my-6 text-center">
            <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" 
               class="inline-block bg-blue-600 text-white font-medium py-2 px-6 rounded-md hover:bg-blue-700 transition duration-200">
                Réinitialiser mon mot de passe
            </a>
        </div>
        
        <p class="text-gray-600 text-sm mb-2">
            Ce lien expirera dans {{ tokenLifetime|date('g') }} heure(s).
        </p>
        
        <p class="text-gray-600 text-sm">
            Si vous n'avez pas demandé de réinitialisation de mot de passe, vous pouvez ignorer cet email.
        </p>
    </div>
{% endblock %}
