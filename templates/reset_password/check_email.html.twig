{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre email{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
            Vérifiez votre email
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            Un email a été envoyé contenant un lien que vous pouvez utiliser pour réinitialiser votre mot de passe.
            Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        </p>
        <p class="mt-2 text-center text-sm text-gray-600">
            Si vous ne recevez pas d'email, veuillez vérifier votre dossier de spam ou <a href="{{ path('app_forgot_password_request') }}" class="text-blue-600 hover:text-blue-500">réessayer</a>.
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 text-center">
            <p class="text-sm text-gray-600">
                <a href="{{ path('app_login') }}" class="font-medium text-blue-600 hover:text-blue-500">
                    Retour à la page de connexion
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
