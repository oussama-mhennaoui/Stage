{% extends 'base.html.twig' %}

{% block title %}Mes Candidatures{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Mes Candidatures</h1>
    
    {% if candidatures|length > 0 %}
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="py-3 px-4 text-left">Offre</th>
                        <th class="py-3 px-4 text-left">Entreprise</th>
                        <th class="py-3 px-4 text-left">Date de candidature</th>
                        <th class="py-3 px-4 text-left">Statut</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for candidature in candidatures %}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="py-3 px-4">
                                <a href="{{ path('app_offre_public_show', {'id': candidature.offre.id}) }}" class="text-blue-600 hover:underline">
                                    {{ candidature.offre.titre }}
                                </a>
                            </td>
                            <td class="py-3 px-4">{{ candidature.offre.entreprise.nom }}</td>
                            <td class="py-3 px-4">{{ candidature.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-1 text-sm rounded-full 
                                    {% if candidature.etatCandidature == 'acceptée' %}
                                        bg-green-100 text-green-800
                                    {% elseif candidature.etatCandidature == 'rejetée' %}
                                        bg-red-100 text-red-800
                                    {% else %}
                                        bg-yellow-100 text-yellow-800
                                    {% endif %}">
                                    {{ candidature.etatCandidature|capitalize }}
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                {% if candidature.cv %}
                                    <a href="{{ asset(candidature.cv) }}" target="_blank" class="text-blue-600 hover:underline mr-2">
                                        Voir CV
                                    </a>
                                {% endif %}
                                {% if candidature.lettreMotivation %}
                                    <a href="{{ asset(candidature.lettreMotivation) }}" target="_blank" class="text-blue-600 hover:underline">
                                        Voir lettre
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4">
            <p class="text-blue-700">Vous n'avez encore postulé à aucune offre.</p>
            <a href="{{ path('app_offre_public') }}" class="inline-block mt-2 text-blue-600 hover:underline">
                Voir les offres disponibles →
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
