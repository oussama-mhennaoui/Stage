{% extends 'base.html.twig' %}

{% block title %}Liste des Enseignants - Demande d'Encadrement{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-2xl font-bold text-gray-900">Liste des Enseignants</h1>
            <p class="mt-2 text-sm text-gray-600">Sélectionnez un enseignant pour lui envoyer une demande d'encadrement.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-white shadow overflow-hidden sm:rounded-md">
            <ul role="list" class="divide-y divide-gray-200">
                {% for enseignant in enseignants %}
                    <li>
                        <div class="px-4 py-4 sm:px-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-indigo-600 truncate">
                                        {{ enseignant.nom }} {{ enseignant.prenom }}
                                    </p>
                                    <div class="mt-1 text-sm text-gray-500">
                                        {{ enseignant.specialite }}
                                    </div>
                                    <div class="mt-1 text-sm text-gray-500">
                                        {{ enseignant.departement }}
                                    </div>
                                </div>
                                <div class="ml-4 flex-shrink-0">
                                    <a href="{{ path('app_encadrement_new', {'enseignantId': enseignant.id}) }}" 
                                       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                        Demander l'encadrement
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                {% else %}
                    <li class="px-4 py-12 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun enseignant trouvé</h3>
                        <p class="mt-1 text-sm text-gray-500">
                            Aucun enseignant n'est actuellement disponible pour l'encadrement.
                        </p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
