{% extends 'base.html.twig' %}

{% block body %}
<div class="flex flex-col h-full w-full">
    <!-- Navbar -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <a href="{{ path('app_home') }}" class="flex items-center">
                        <span class="text-xl font-bold text-blue-600">GestionOffre</span>
                    </a>
                </div>

                <div class="hidden md:flex items-center space-x-4">
                    {% if app.user %}
                        <a href="{{ path('app_admin') }}" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
                        <a href="{{ path('app_logout') }}" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700">Logout</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">Sign In</a>
                        <a href="{{ path('app_register') }}" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700">Sign Up</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="flex-1 flex items-center justify-center bg-gradient-to-r from-blue-500 to-purple-600">
        <div class="max-w-7xl mx-auto px-4 py-12 text-center">
            <h1 class="text-4xl font-bold text-white mb-4">Bienvenue sur GestionOffre</h1>
            <p class="text-xl text-white/90">La plateforme de gestion des offres de stage et d'emploi</p>
        </div>
    </div>

    <!-- Features Section -->
    <div class="bg-gray-50 py-12">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12">Pour qui ?</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-6 rounded-lg shadow">
                    <h3 class="text-xl font-semibold mb-4">Étudiants</h3>
                    <p>Recherchez et postulez aux offres de stage adaptées à votre profil.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow">
                    <h3 class="text-xl font-semibold mb-4">Diplômés</h3>
                    <p>Accédez aux opportunités d'emploi pour débuter votre carrière.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow">
                    <h3 class="text-xl font-semibold mb-4">Entreprises</h3>
                    <p>Publiez vos offres de stage et d'emploi pour attirer les meilleurs talents.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-lg font-semibold mb-4">GestionOffre</h3>
                    <p class="text-gray-400">La plateforme de gestion des offres de stage et d'emploi.</p>
                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-4">Navigation</h3>
                    <ul class="space-y-2">
                        <li><a href="{{ path('app_home') }}" class="text-gray-400 hover:text-white">Accueil</a></li>
                        {% if app.user %}
                        <li><a href="{{ path('app_admin') }}" class="text-gray-400 hover:text-white">Dashboard</a></li>
                        {% endif %}
                    </ul>
                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-4">Rôles</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-400 hover:text-white">Étudiants</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Diplômés</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Entreprises</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-4">Contact</h3>
                    <p class="text-gray-400">Email: contact@gestionoffre.com</p>
                </div>
            </div>
            <div class="mt-8 pt-8 border-t border-gray-700 text-center text-gray-400">
                <p>&copy; {{ 'now'|date('Y') }} GestionOffre. Tous droits réservés.</p>
            </div>
        </div>
    </footer>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}
