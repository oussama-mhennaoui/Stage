{% extends 'encadrement/base.html.twig' %}

{% block page_title %}Mes demandes d'encadrement{% endblock %}

{% block actions %}
    {% if is_granted('ROLE_ETUDIANT') %}
        <a href="{{ path('app_enseignant_list') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Nouvelle demande
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <ul role="list" class="divide-y divide-gray-200">
            {% for encadrement in encadrements %}
                <li class="hover:bg-gray-50">
                    <div class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <p class="text-sm font-medium text-gray-900 truncate">
                                {% if is_granted('ROLE_ETUDIANT') %}
                                    {{ encadrement.enseignant.getFullName() }}
                                {% else %}
                                    {{ encadrement.etudiant.getFullName() }}
                                {% endif %}
                            </p>
                            <div class="ml-2 flex-shrink-0 flex">
                                {% if encadrement.status == 'pending' %}
                                    <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        En attente
                                    </p>
                                {% elseif encadrement.status == 'accepted' %}
                                    <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        Accepté
                                    </p>
                                {% else %}
                                    <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        Rejeté
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="mt-2">
                            <p class="flex items-center text-sm text-gray-500">
                                <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                                </svg>
                                {{ encadrement.createdAt|date('d/m/Y H:i') }}
                            </p>
                        </div>
                    </div>
                </li>
            {% else %}
                <li class="px-4 py-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">Aucune demande trouvée</h3>
                    <p class="mt-1 text-sm text-gray-500">
                        {% if is_granted('ROLE_ETUDIANT') %}
                            Vous n'avez pas encore fait de demande d'encadrement.
                        {% else %}
                            Aucune demande d'encadrement reçue.
                        {% endif %}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
