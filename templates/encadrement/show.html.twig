{% extends 'encadrement/base.html.twig' %}

{% block page_title %}
    Détails de la demande d'encadrement
{% endblock %}

{% block actions %}
    <a href="{{ path('app_encadrement_index') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        Retour à la liste
    </a>
{% endblock %}

{% block content %}
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <div class="px-4 py-5 sm:px-6">
            <div class="flex justify-between items-center">
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                    Demande d'encadrement
                </h3>
                {% if encadrement.status == 'pending' and is_granted('ROLE_ENSEIGNANT') %}
                    <div class="flex space-x-3
                        <form method="post" action="{{ path('app_encadrement_accept', {'id': encadrement.id}) }}" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ encadrement.id) }}">
                            <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                                Accepter
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_encadrement_reject', {'id': encadrement.id}) }}" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ encadrement.id) }}">
                            <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                Rejeter
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>
            <p class="mt-1 max-w-2xl text-sm text-gray-500">
                Détails de la demande d'encadrement
            </p>
        </div>
        <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
            <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">
                        Étudiant
                    </dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {{ encadrement.etudiant }}
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">
                        Enseignant
                    </dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {{ encadrement.enseignant }}
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">
                        Statut
                    </dt>
                    <dd class="mt-1 text-sm">
                        {% if encadrement.status == 'pending' %}
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                En attente
                            </span>
                        {% elseif encadrement.status == 'accepted' %}
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                Accepté
                            </span>
                        {% else %}
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                Rejeté
                            </span>
                        {% endif %}
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">
                        Date de la demande
                    </dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {{ encadrement.createdAt|date('d/m/Y H:i') }}
                    </dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-sm font-medium text-gray-500">
                        CV
                    </dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {% if encadrement.cvName %}
                            <a href="{{ asset('uploads/encadrement/cv/' ~ encadrement.cvName) }}" 
                               target="_blank" 
                               class="text-indigo-600 hover:text-indigo-900">
                                <div class="flex items-center">
                                    <svg class="flex-shrink-0 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="ml-2">Télécharger le CV</span>
                                </div>
                            </a>
                        {% else %}
                            <span class="text-gray-500">Aucun CV téléchargé</span>
                        {% endif %}
                    </dd>
                </div>
            </dl>
        </div>
    </div>
{% endblock %}
