{% extends 'base.html.twig' %}

{% block title %}Offres disponibles{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Offres disponibles</h1>
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:space-x-4 space-y-2 md:space-y-0">
        <label for="typeFilter" class="font-medium">Filtrer par type :</label>
        <select id="typeFilter" class="border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring focus:border-blue-300 w-full md:w-auto">
    <option value="">Tous</option>
    {% for type in types %}
        <option value="{{ type }}">{{ type|capitalize }}</option>
    {% endfor %}
</select>
    </div>
    <div id="offersContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for offre in offres %}
        <div class="offer-card bg-white shadow-lg rounded-lg p-6 flex flex-col transition-transform hover:scale-105" data-type="{{ offre.typeOffre.value }}">
            <div class="flex-1">
                <h2 class="text-xl font-semibold text-blue-700 mb-2">{{ offre.titre }}</h2>
                <p class="text-gray-700 mb-2">{{ offre.description|length > 120 ? offre.description|slice(0, 120) ~ '...' : offre.description }}</p>
                <p class="text-sm text-gray-500 mb-1"><span class="font-medium">Durée :</span> {{ offre.duree }}</p>
                <p class="text-sm text-gray-500 mb-1"><span class="font-medium">Type :</span> <span class="badge bg-blue-100 text-blue-700 px-2 py-1 rounded">{{ offre.typeOffre.value|capitalize }}</span></p>
                <p class="text-sm text-gray-500 mb-3"><span class="font-medium">Entreprise :</span> {{ offre.entreprise.nom }}</p>
            </div>
            {% if app.user and (is_granted('ROLE_ETUDIANT') or is_granted('ROLE_DIPLOME')) %}
    {# Vérifier si l'utilisateur a déjà postulé à cette offre #}
    {% set dejaPostule = false %}
    {% for cand in offre.candidatures %}
        {% if cand.candidat == app.user %}
            {% set dejaPostule = true %}
        {% endif %}
    {% endfor %}

    {% if dejaPostule %}
        <span class="mt-4 inline-block bg-gray-300 text-gray-700 px-4 py-2 rounded-md font-medium text-center cursor-not-allowed">Candidature déjà soumise</span>
    {% else %}
        <a href="{{ path('app_candidature_new', {'offreId': offre.id}) }}" class="mt-4 bg-green-600 text-white px-4 py-2 rounded-md font-medium text-center hover:bg-green-700 transition">Postuler</a>
    {% endif %}
{% endif %}
        </div>
        {% else %}
        <div class="col-span-full text-center text-gray-500">Aucune offre disponible</div>
        {% endfor %}
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filter = document.getElementById('typeFilter');
        const offers = document.querySelectorAll('.offer-card');
        filter.addEventListener('change', function() {
            const value = filter.value;
            offers.forEach(card => {
                if (!value || card.getAttribute('data-type') === value) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>
{% endblock %}
