{% extends 'base.html.twig' %}

{% block title %}Offre index{% endblock %}

{% block body %}
    <div class="container px-4 py-8">
        <h1 class="text-3xl font-bold mb-6">Manage Offers</h1>

        <a href="{{ path('app_offre_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 mb-4 inline-block">Create new</a>

        <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
            <thead class="bg-gray-200">
                <tr>
                    <th class="py-3 px-4 text-left">Id</th>
                    <th class="py-3 px-4 text-left">Titre</th>
                    <th class="py-3 px-4 text-left">Description</th>
                    <th class="py-3 px-4 text-left">Duree</th>
                    <th class="py-3 px-4 text-left">TypeOffre</th>
                    <th class="py-3 px-4 text-left">actions</th>
                </tr>
            </thead>
            <tbody>
            {% for offre in offres %}
                <tr class="border-b">
                    <td class="py-3 px-4">{{ offre.id }}</td>
                    <td class="py-3 px-4">{{ offre.titre }}</td>
                    <td class="py-3 px-4">{{ offre.description }}</td>
                    <td class="py-3 px-4">{{ offre.duree }}</td>
                    <td class="py-3 px-4">{{ offre.typeOffre.value }}</td>
                    <td class="py-3 px-4 flex items-center">
                        <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="text-yellow-600 hover:underline">edit</a>
                        <div class="ml-2">
                            {{ include('offre/_delete_form.html.twig') }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="py-3 px-4 text-center">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
