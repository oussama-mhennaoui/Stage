{% extends 'base.html.twig' %}

{% block title %}Offre{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-6">Offre Details</h1>

        <div class="bg-white shadow-md rounded-lg p-6">
            <table class="min-w-full">
                <tbody>
                    <tr class="border-b">
                        <th class="py-2 px-4 text-left font-semibold">Id</th>
                        <td class="py-2 px-4">{{ offre.id }}</td>
                    </tr>
                    <tr class="border-b">
                        <th class="py-2 px-4 text-left font-semibold">Titre</th>
                        <td class="py-2 px-4">{{ offre.titre }}</td>
                    </tr>
                    <tr class="border-b">
                        <th class="py-2 px-4 text-left font-semibold">Description</th>
                        <td class="py-2 px-4">{{ offre.description }}</td>
                    </tr>
                    <tr class="border-b">
                        <th class="py-2 px-4 text-left font-semibold">Duree</th>
                        <td class="py-2 px-4">{{ offre.duree }}</td>
                    </tr>
                    <tr>
                        <th class="py-2 px-4 text-left font-semibold">TypeOffre</th>
                        <td class="py-2 px-4">{{ offre.typeOffre.value }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-6">
            <a href="{{ path('app_offre_index') }}" class="text-gray-600 hover:underline">back to list</a>
            <a href="{{ path('app_offre_edit', {'id': offre.id}) }}" class="bg-yellow-500 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-yellow-600 ml-4">edit</a>
        </div>

        <div class="mt-4">
            {{ include('offre/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
