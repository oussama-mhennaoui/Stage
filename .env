###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Gmail example (enable app passwords in your Google account):
# MAILER_DSN=gmail://YOUR_EMAIL@gmail.com:YOUR_APP_PASSWORD@default

# Or use a standard SMTP server (replace with your SMTP details):
MAILER_DSN=gmail://omhennaoui@gmail.com:stbhwggwdfchwgln@smtp.example.com:587?encryption=tls&auth_mode=login

# Example for Gmail SMTP (requires app password):
# MAILER_DSN=smtp://your.email@gmail.com:your_app_password@smtp.gmail.com:587?encryption=tls&auth_mode=login

# Example for Office 365:
# MAILER_DSN=smtp://your.email@yourdomain.com:your_password@smtp.office365.com:587?encryption=tls&auth_mode=login
###< symfony/mailer ###

